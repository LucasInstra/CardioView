<Window x:Class="CardioView.Views.EcgViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CardioView.Controls"
        xmlns:converters="clr-namespace:CardioView.Converters"
        Title="CardioView - Visualizador de ECG" Width="1150" Height="660"
        MinWidth="900" MinHeight="480"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF050505" WindowStartupLocation="Manual"
        FontFamily="Segoe UI">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" GlassFrameThickness="0" CaptionHeight="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"
                      CornerRadius="16,16,16,16"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Color x:Key="ColEcg">#FF2BFF5A</Color>
        <SolidColorBrush x:Key="BrushEcg" Color="{StaticResource ColEcg}"/>
        <SolidColorBrush x:Key="BrushDim" Color="#FF7A7A7A"/>
        <SolidColorBrush x:Key="BrushText" Color="#FFC8C8C8"/>
        <SolidColorBrush x:Key="BrushBar" Color="#FF0D0D0D"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#FF0B0B0B"/>
        <SolidColorBrush x:Key="BrushSep" Color="#FF2A2A2A"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InverseBoolToVisibilityConverter x:Key="InvBoolToVis"/>
        <converters:SeverityBrushConverter x:Key="SevBrush"/>

        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" CornerRadius="4" Background="#FF141414"
                                                BorderBrush="#FF3A3A3A" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" Margin="10,0,6,0" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
                                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" Foreground="{StaticResource BrushDim}"
                                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5A5A5A"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushEcg}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border Background="#FF141414" BorderBrush="#FF3A3A3A" BorderThickness="1"
                                        CornerRadius="4" Margin="0,3,0,0" MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="220" SnapsToDevicePixels="True">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1E4A2A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Background" Value="#FF141414"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF5A5A5A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushBar}" BorderBrush="{StaticResource BrushSep}"
                BorderThickness="0,0,0,1" MouseLeftButtonDown="OnTopBarMouseDown">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Visualizador de ECG" Foreground="White" FontSize="15" FontWeight="Bold"/>
                    <TextBlock Text="{Binding RecordText}" Foreground="{StaticResource BrushDim}" FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding HrText}" Foreground="{StaticResource BrushEcg}" FontFamily="Consolas"
                                   FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                        <ComboBox ItemsSource="{Binding LeadNames}"
                                  SelectedIndex="{Binding SelectedLead}" Width="130" Height="26" Margin="16,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding AnnotationText}" Foreground="{StaticResource BrushDim}" FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ViewerButton}" Click="OnLoadClick" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="CARREGAR ECG"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OnPlayClick" Margin="4,0">
                        <TextBlock Text="{Binding PlayButtonText}"/>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OnRestartClick" Margin="4,0">
                        <TextBlock Text="REINICIAR"/>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OnTagsClick" Margin="4,0">
                        <TextBlock Text="{Binding TagsButtonText}"/>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OnReportClick" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="RELATÓRIO"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OnMonitorClick" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0"/>
                            <TextBlock Text="MONITOR"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ViewerButton}" Click="OnCloseClick" Margin="8,0,0,0" Padding="9,5">
                        <TextBlock Text="✕" Foreground="{StaticResource BrushDim}" FontSize="13"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource BrushPanel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>

                <Grid x:Name="WaveformGrid">
                    <controls:WaveformControl x:Name="EcgControl"
                                              SamplesPerSecond="360" SecondsVisible="6" GridDotted="True"
                                              TraceColor="{StaticResource ColEcg}"/>

                    <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource ViewerButton}" Click="OnLegendClick" Padding="11,4">
                                <TextBlock Text="LEGENDAS"/>
                            </Button>
                            <Button Style="{StaticResource ViewerButton}" Click="OnDiagnosisClick" Padding="11,4" Margin="6,0,0,0">
                                <TextBlock Text="DIAGNÓSTICO"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <Border Background="#E60D0D0D" BorderBrush="{StaticResource BrushSep}" BorderThickness="1"
                                CornerRadius="4" Padding="12,7" MaxWidth="760"
                                MaxHeight="{Binding ActualHeight, ElementName=WaveformGrid}"
                                Visibility="{Binding IsLegendOpen, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Carregue um registro com anotações (.atr) para ver as tags."
                                           Foreground="#FF9E9E9E" FontSize="11"
                                           Visibility="{Binding ShowLegendHint, Converter={StaticResource BoolToVis}}"/>
                                <ItemsControl ItemsSource="{Binding Legend}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,1,20,2">
                                                <TextBlock Text="{Binding Symbol}" FontWeight="Bold" Foreground="White"
                                                           FontSize="11"/>
                                                <TextBlock Text=":" Foreground="{StaticResource BrushDim}" FontSize="11"
                                                           Margin="2,0"/>
                                                <TextBlock Text="{Binding Meaning}" Foreground="#FFC8C8C8" FontSize="11"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Background="#F00D0D0D" BorderBrush="{StaticResource BrushSep}" BorderThickness="1"
                                CornerRadius="4" Padding="12,8" Margin="0,8,0,0" MaxWidth="780"
                                MaxHeight="{Binding ActualHeight, ElementName=WaveformGrid}"
                                Visibility="{Binding IsDiagnosisOpen, Converter={StaticResource BoolToVis}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <TextBlock Text="Carregue um registro com anotações (.atr) para a análise de ritmo."
                                           Foreground="#FF9E9E9E" FontSize="11"
                                           Visibility="{Binding DiagnosisHasData, Converter={StaticResource InvBoolToVis}}"/>
                                <TextBlock Text="{Binding DiagnosisSummary}" Foreground="White" FontSize="13"
                                           FontWeight="Bold" TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding DiagnosisFindings}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Top"
                                                            Margin="0,0,8,0">
                                                    <Border CornerRadius="3" Padding="6,1"
                                                            Background="{Binding Severity, Converter={StaticResource SevBrush}}">
                                                        <TextBlock Text="{Binding SeverityText}" Foreground="Black"
                                                                   FontSize="9" FontWeight="Bold"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CountBadge}" Foreground="#FF9E9E9E"
                                                               FontSize="10" FontWeight="Bold" VerticalAlignment="Center"
                                                               Margin="6,0,0,0"
                                                               Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Condition}" Foreground="White" FontSize="11"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Evidence}" Foreground="#FF9E9E9E" FontSize="10"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Análise automática baseada nas anotações (.atr) — não substitui avaliação médica."
                                           Foreground="#FF6E6E6E" FontSize="9" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Border Grid.Row="1" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,1,0,0"
                        Background="#FF0B0B0B">
                    <controls:AnnotationOverview x:Name="Overview"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="#FF0A0A0A" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource BrushDim}" FontSize="11"
                       VerticalAlignment="Center" Margin="14,0"/>
        </Border>
    </Grid>
</Window>
