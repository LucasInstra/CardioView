<Window x:Class="CardioView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CardioView.Controls"
        xmlns:conv="clr-namespace:CardioView.Converters"
        Title="CardioView - Monitor" Width="1920" Height="1032"
        MinWidth="1200" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        Background="#FF050505" WindowStartupLocation="Manual"
        FontFamily="Segoe UI" KeyDown="OnWindowKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome x:Name="Chrome" GlassFrameThickness="0" CaptionHeight="0"
                      ResizeBorderThickness="6" UseAeroCaptionButtons="False"
                      CornerRadius="20,20,20,20"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <Color x:Key="ColEcg">#FF2BFF5A</Color>
        <Color x:Key="ColSpo2">#FF38B6FF</Color>
        <Color x:Key="ColP1">#FFFF9A2E</Color>
        <Color x:Key="ColP2">#FFFF9A2E</Color>
        <Color x:Key="ColCo2">#FFC07CFF</Color>
        <Color x:Key="ColResp">#FFFF5FC9</Color>
        <Color x:Key="ColTemp">#FFFFE14D</Color>
        <Color x:Key="ColAlarm">#FFFF3B30</Color>

        <SolidColorBrush x:Key="BrushEcg" Color="{StaticResource ColEcg}"/>
        <SolidColorBrush x:Key="BrushSpo2" Color="{StaticResource ColSpo2}"/>
        <SolidColorBrush x:Key="BrushP1" Color="{StaticResource ColP1}"/>
        <SolidColorBrush x:Key="BrushP2" Color="{StaticResource ColP2}"/>
        <SolidColorBrush x:Key="BrushCo2" Color="{StaticResource ColCo2}"/>
        <SolidColorBrush x:Key="BrushResp" Color="{StaticResource ColResp}"/>
        <SolidColorBrush x:Key="BrushTemp" Color="{StaticResource ColTemp}"/>
        <SolidColorBrush x:Key="BrushAlarm" Color="{StaticResource ColAlarm}"/>
        <SolidColorBrush x:Key="BrushText" Color="#FFC8C8C8"/>
        <SolidColorBrush x:Key="BrushDim" Color="#FF7A7A7A"/>
        <SolidColorBrush x:Key="BrushPanel" Color="#FF0B0B0B"/>
        <SolidColorBrush x:Key="BrushBar" Color="#FF0D0D0D"/>
        <SolidColorBrush x:Key="BrushToolbar" Color="#FF141414"/>
        <SolidColorBrush x:Key="BrushSep" Color="#FF2A2A2A"/>
        <SolidColorBrush x:Key="BrushSep2" Color="#FF262626"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:PatientStateNameConverter x:Key="StateNameConv"/>
        <conv:StateSelectedConverter x:Key="StateSelConv"/>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionUnit" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Bottom"/>
            <Setter Property="Margin" Value="6,0,0,1"/>
        </Style>

        <Style x:Key="BigNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="38"/>
        </Style>

        <Style x:Key="HrNumber" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
            <Setter Property="Foreground" Value="{StaticResource BrushEcg}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding HrNormal}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Spo2Number" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
            <Setter Property="Foreground" Value="{StaticResource BrushSpo2}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Spo2Normal}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NibpNumber" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
            <Setter Property="Foreground" Value="{StaticResource BrushP1}"/>
            <Setter Property="FontSize" Value="29"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding NibpNormal}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Co2Number" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
            <Setter Property="Foreground" Value="{StaticResource BrushCo2}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Etco2Normal}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RespNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource BrushResp}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding RespNormal}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TempNumber" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTemp}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding TempNormal}" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MiniLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="SectionValue" TargetType="TextBlock" BasedOn="{StaticResource BigNumber}">
            <Setter Property="Foreground" Value="{StaticResource BrushEcg}"/>
        </Style>

        <Style x:Key="ToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF242424"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF323232"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ToolLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF9A9A9A"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

        <Style x:Key="BellIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="{StaticResource BrushText}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmSystemEnabled}" Value="False">
                    <Setter Property="Foreground" Value="#FF555555"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding AlarmActive}" Value="True"/>
                        <Condition Binding="{Binding AlarmFlash}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StatePill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#FF2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FF4A4A4A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DevTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FF141414"/>
            <Setter Property="Foreground" Value="#FFC8C8C8"/>
            <Setter Property="BorderBrush" Value="#FF3A3A3A"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="MonitorButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushEcg}"/>
            <Setter Property="Background" Value="#FF0A2314"/>
            <Setter Property="BorderBrush" Value="#FF1E6B3E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF12402A"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF1A5C3A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DevCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFC8C8C8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushBar}" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="OnTopBarMouseDown" MouseLeftButtonUp="OnTopBarMouseUp">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="{Binding TimeText}" Foreground="White" FontFamily="Consolas" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="{Binding DateText}" Foreground="{StaticResource BrushDim}" FontSize="10"/>
                    </StackPanel>
                    <TextBlock Text="{Binding PatientLabel}" Foreground="White" FontSize="15" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource BrushEcg}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding AlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding AlarmFlash}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Fill" Value="{StaticResource BrushAlarm}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding AlarmStatus}" FontSize="12" Cursor="Hand" MouseLeftButtonDown="OnSoundToggle" Margin="9,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource BrushDim}"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding AlarmActive}" Value="True"/>
                                            <Condition Binding="{Binding AlarmFlash}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Foreground" Value="{StaticResource BrushAlarm}"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="ADULTO" Foreground="{StaticResource BrushDim}" FontSize="12" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="16,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="85%" Foreground="{StaticResource BrushDim}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Grid Width="28" Height="13">
                            <Rectangle Fill="#FF050505" Stroke="#FF808080" StrokeThickness="1" Width="24" Height="11" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                            <Rectangle Fill="{StaticResource BrushEcg}" Width="15" Height="7" HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                            <Rectangle Width="3" Height="5" Fill="#FF808080" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-4,0"/>
                        </Grid>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding States}" VerticalAlignment="Center" Margin="14,0,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="OnStateClick" Margin="3,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource StatePill}">
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource StateSelConv}">
                                                            <Binding Path="DataContext.State" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                                            <Binding/>
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Foreground" Value="{StaticResource BrushEcg}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushEcg}"/>
                                                    <Setter Property="Background" Value="#FF0A2314"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <TextBlock Text="{Binding Converter={StaticResource StateNameConv}}"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="✕" Width="30" Height="30" Margin="14,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" FontSize="14" Click="OnCloseClick"
                            VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Foreground" Value="#FF7A7A7A"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Foreground" Value="#FFFF3B30"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="302"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="6*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="3*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ECG1" Foreground="{StaticResource BrushEcg}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="mV" Style="{StaticResource SectionUnit}"/>
                        </StackPanel>
                        <controls:WaveformControl x:Name="EcgControl" Grid.Row="1" Margin="0,4,0,0"
                                                  SamplesPerSecond="250" SecondsVisible="6" GridDotted="True"
                                                  TraceColor="{StaticResource ColEcg}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="SpO2" Foreground="{StaticResource BrushSpo2}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="%" Style="{StaticResource SectionUnit}"/>
                        </StackPanel>
                        <controls:WaveformControl x:Name="Spo2Control" Grid.Row="1" Margin="0,4,0,0"
                                                  SamplesPerSecond="250" SecondsVisible="6"
                                                  TraceColor="{StaticResource ColSpo2}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,0,0,1" Padding="12,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="P1" Foreground="{StaticResource BrushP1}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="mmHg" Style="{StaticResource SectionUnit}"/>
                        </StackPanel>
                        <controls:WaveformControl x:Name="P1Control" Grid.Row="1" Margin="0,3,0,0"
                                                  SamplesPerSecond="250" SecondsVisible="6"
                                                  TraceColor="{StaticResource ColP1}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,0,0,1" Padding="12,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="P2" Foreground="{StaticResource BrushP2}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="mmHg" Style="{StaticResource SectionUnit}"/>
                        </StackPanel>
                        <controls:WaveformControl x:Name="P2Control" Grid.Row="1" Margin="0,3,0,0"
                                                  SamplesPerSecond="250" SecondsVisible="6"
                                                  TraceColor="{StaticResource ColP2}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="4" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="EtCO2" Foreground="{StaticResource BrushCo2}" FontSize="12" FontWeight="Bold"/>
                            <TextBlock Text="mmHg" Style="{StaticResource SectionUnit}"/>
                        </StackPanel>
                        <controls:WaveformControl x:Name="Co2Control" Grid.Row="1" Margin="0,4,0,0"
                                                  SamplesPerSecond="250" SecondsVisible="6"
                                                  TraceColor="{StaticResource ColCo2}"/>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,1,0,0" Padding="14,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FR (rpm)" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding RespText}" Style="{StaticResource RespNumber}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Fill="{StaticResource BrushSep}" VerticalAlignment="Stretch" Margin="18,2"/>
                        <StackPanel Grid.Column="2" Margin="18,0,0,0">
                            <TextBlock Text="T1 (°C)" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding Temp1Text}" Style="{StaticResource TempNumber}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Fill="{StaticResource BrushSep}" VerticalAlignment="Stretch" Margin="18,2"/>
                        <StackPanel Grid.Column="4" Margin="18,0,0,0">
                            <TextBlock Text="T2 (°C)" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding Temp2Text}" Style="{StaticResource TempNumber}" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Rectangle Grid.Column="5" Width="1" Fill="{StaticResource BrushSep}" VerticalAlignment="Stretch" Margin="18,2"/>
                        <StackPanel Grid.Column="6" Margin="18,0,0,0">
                            <TextBlock Text="ΔT (min)" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding DeltaText}" FontFamily="Consolas" FontWeight="Bold" FontSize="20" Foreground="{StaticResource BrushText}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushSep}" BorderThickness="1,0,1,0">
                <Grid Margin="8,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="ST" Style="{StaticResource MiniLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="(mm)" Style="{StaticResource MiniLabel}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding StText}" FontFamily="Consolas" FontWeight="Bold" FontSize="15" Foreground="{StaticResource BrushEcg}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <TextBlock Text="▲" FontSize="11" Foreground="{StaticResource BrushEcg}" HorizontalAlignment="Center"/>
                        <TextBlock Text="▼" FontSize="11" Foreground="{StaticResource BrushDim}" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
                        <TextBlock Text="{Binding MapText}" FontFamily="Consolas" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushEcg}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2" Background="{StaticResource BrushPanel}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="{StaticResource BrushSep2}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="FC (bpm)" Style="{StaticResource SectionLabel}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Path Data="M12,21.35 L10.55,20.03 C5.4,15.36 2,12.28 2,8.5 C2,5.42 4.42,3 7.5,3 C9.24,3 10.91,3.81 12,5.09 C13.09,3.81 14.76,3 16.5,3 C19.58,3 22,5.42 22,8.5 C22,12.28 18.6,15.36 13.45,20.03 Z"
                                      Fill="#FFFF3B30" Width="21" Height="21" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="HeartScale"/>
                                    </Path.RenderTransform>
                                    <Path.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleX" From="1" To="1.3" Duration="0:0:0.30" AutoReverse="True" RepeatBehavior="Forever"/>
                                                    <DoubleAnimation Storyboard.TargetName="HeartScale" Storyboard.TargetProperty="ScaleY" From="1" To="1.3" Duration="0:0:0.30" AutoReverse="True" RepeatBehavior="Forever"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Path.Triggers>
                                </Path>
                                <TextBlock Text="{Binding HrText}" Style="{StaticResource HrNumber}" Margin="11,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <TextBlock Text="ST 2.3 mm" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="▲  ▼" Style="{StaticResource MiniLabel}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" BorderBrush="{StaticResource BrushSep2}" BorderThickness="0,0,0,1" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="SpO2 (%)" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="{Binding Spo2Text}" Style="{StaticResource Spo2Number}" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="8,0,0,8">
                            <Rectangle Width="4" Height="8" Fill="{StaticResource BrushSpo2}" Margin="1,0"/>
                            <Rectangle Width="4" Height="12" Fill="{StaticResource BrushSpo2}" Margin="1,0"/>
                            <Rectangle Width="4" Height="16" Fill="{StaticResource BrushSpo2}" Margin="1,0"/>
                            <Rectangle Width="4" Height="20" Fill="{StaticResource BrushSpo2}" Margin="1,0"/>
                            <Rectangle Width="4" Height="24" Fill="#FF1A5B85" Margin="1,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" BorderBrush="{StaticResource BrushSep2}" BorderThickness="0,0,0,1" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="P1 (mmHg)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding P1Text}" Style="{StaticResource NibpNumber}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" BorderBrush="{StaticResource BrushSep2}" BorderThickness="0,0,0,1" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="P2 (mmHg)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding P2Text}" Style="{StaticResource NibpNumber}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" BorderBrush="{StaticResource BrushSep2}" BorderThickness="0,0,0,1" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="EtCO2 (mmHg)" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding Etco2Text}" Style="{StaticResource Co2Number}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="FiCO2 (mmHg):" Style="{StaticResource MiniLabel}"/>
                            <TextBlock Text="{Binding Fico2Text}" FontFamily="Consolas" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushCo2}" Margin="7,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="6" Background="#FF0D0D0D" BorderBrush="{StaticResource BrushSep2}" BorderThickness="0,1,0,0" Padding="14,12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="PNI (mmHg)" Style="{StaticResource SectionLabel}"/>
                            <TextBlock Text="  AUTO" Foreground="{StaticResource BrushP1}" FontSize="10" FontWeight="Bold"
                                       Visibility="{Binding AutoNibp, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding NibpText}" Style="{StaticResource NibpNumber}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushToolbar}" BorderBrush="{StaticResource BrushSep}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnAjustesClick">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="AJUSTES" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="1" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnNibpClick">
                        <StackPanel>
                            <TextBlock Text="&#xEB51;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="{Binding NibpButtonText}" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="2" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnCapturaClick">
                        <StackPanel>
                            <TextBlock Text="&#xE722;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="CAPTURA" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="3" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnAutoClick">
                        <StackPanel>
                            <TextBlock Text="&#xE7B3;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="AUTO" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="4" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnTrendClick">
                        <StackPanel>
                            <TextBlock Text="&#xE9D2;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="TENDÊNCIA" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="5" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnMarcarClick">
                        <StackPanel>
                            <TextBlock Text="&#xE707;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="MARCAR" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="6" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnAlarmesClick">
                        <StackPanel>
                            <TextBlock Text="&#xE7EA;" Style="{StaticResource BellIcon}"/>
                            <TextBlock Text="ALARMES" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="7" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnPauseClick">
                        <StackPanel>
                            <TextBlock Text="&#xE769;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="{Binding PauseButtonText}" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>
                <Border Grid.Column="8" BorderBrush="{StaticResource BrushSep2}" BorderThickness="1,0,0,0">
                    <Button Style="{StaticResource ToolbarButton}" Click="OnEcgClick">
                        <StackPanel>
                            <TextBlock Text="&#xE9D9;" Style="{StaticResource ToolIcon}"/>
                            <TextBlock Text="ECG" Style="{StaticResource ToolLabel}"/>
                        </StackPanel>
                    </Button>
                </Border>

                <TextBlock Grid.Column="9" Text="{Binding ToolbarRightText}" Foreground="{StaticResource BrushDim}" FontSize="10" VerticalAlignment="Center" Margin="14,0"/>
            </Grid>
        </Border>

        <Grid Grid.RowSpan="3" Background="#B0000000"
              Visibility="{Binding IsOverlayOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="640" MaxHeight="580" Background="#FF101010" BorderBrush="{StaticResource BrushSep}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="18,12">
                        <TextBlock Text="{Binding OverlayTitle}" FontSize="16" FontWeight="Bold" Foreground="White"/>
                        <Button Content="✕" Width="28" Height="28" HorizontalAlignment="Right"
                                Background="Transparent" Foreground="{StaticResource BrushDim}" BorderThickness="0"
                                Cursor="Hand" FontSize="15" Click="OnOverlayCloseClick"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="18,4,18,18">

                        <StackPanel Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="LIMITES DE ALARME" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="FC máxima (bpm)" Style="{StaticResource MiniLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                                <TextBox Grid.Column="1" Style="{StaticResource DevTextBox}" Text="{Binding HrHighLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="1" Text="FC mínima (bpm)" Style="{StaticResource MiniLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource DevTextBox}" Text="{Binding HrLowLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="2" Text="SpO2 mínima (%)" Style="{StaticResource MiniLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource DevTextBox}" Text="{Binding Spo2LowLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="3" Text="PAS máxima (mmHg)" Style="{StaticResource MiniLabel}" VerticalAlignment="Center" Margin="0,4,0,4"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource DevTextBox}" Text="{Binding SysHighLimit, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4"/>
                            </Grid>

                            <TextBlock Text="OPÇÕES" Style="{StaticResource SectionLabel}" Margin="0,16,0,4"/>
                            <CheckBox Content="Som de alarme" Style="{StaticResource DevCheck}" IsChecked="{Binding SoundEnabled}"/>
                            <CheckBox Content="Sistema de alarmes ativo" Style="{StaticResource DevCheck}" IsChecked="{Binding AlarmSystemEnabled}"/>
                            <TextBlock Text="Somente simulação — valores e alarmes não representam dados médicos reais." Foreground="{StaticResource BrushDim}" FontSize="10" Margin="0,14,0,0"/>
                        </StackPanel>

                        <Grid Visibility="{Binding IsTrendsOpen, Converter={StaticResource BoolToVis}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="TENDÊNCIA — últimas leituras" Style="{StaticResource SectionLabel}" Margin="0,0,0,10"/>
                            <ListBox Grid.Row="1" ItemsSource="{Binding TrendRows}" Background="#FF050505"
                                     Foreground="{StaticResource BrushEcg}" FontFamily="Consolas" FontSize="13"
                                     BorderBrush="{StaticResource BrushSep}" BorderThickness="1"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto" MaxHeight="380"/>
                            <Button Grid.Row="2" Content="Limpar" Style="{StaticResource MonitorButton}" Click="OnTrendClearClick"
                                    HorizontalAlignment="Left" Margin="0,12,0,0"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
